generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String
  branch              String
  year                Int
  semester            Int
  cgpa                Float
  graduationYear      Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  
  skills              Skill[]
  interests           Interest[]
  placementPreference PlacementPreference?
  
  eligibilities       OpportunityEligibility[]
  tasks               Task[]
  notifications       Notification[]
}

model Skill {
  id        String   @id @default(uuid())
  userId    String
  name      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
}

model Interest {
  id        String   @id @default(uuid())
  userId    String
  name      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
}

model PlacementPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  name            String?
  preferredRoles  String // JSON stringified array
  expectedCtc     Float?
  locations       String // JSON stringified array
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notice {
  id           String             @id @default(uuid())
  title        String
  description  String
  category     String
  source       String?
  sourceUrl    String?
  rawText      String
  summary      String?
  deadline     DateTime?
  eventDate    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  
  requirements NoticeRequirement?
  opportunity  Opportunity?
  tasks        Task[]
}

model NoticeRequirement {
  id              String   @id @default(uuid())
  noticeId        String   @unique
  notice          Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  
  branches        String // JSON stringified array
  years           String // JSON stringified array
  minimumCGPA     Float?
  graduationYears String // JSON stringified array
  skills          String // JSON stringified array
}

model Opportunity {
  id              String    @id @default(uuid())
  noticeId        String    @unique
  notice          Notice    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  organization    String?
  title           String
  description     String
  location        String?
  category        String
  
  eligibilities   OpportunityEligibility[]
}

model OpportunityEligibility {
  id            String         @id @default(uuid())
  opportunityId String
  userId        String
  eligible      Boolean        @default(false)
  score         Float          @default(0)
  reasons       String // JSON stringified array
  priority      String         @default("LOW") // 'LOW', 'MEDIUM', 'HIGH'
  createdAt     DateTime       @default(now())

  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
}

model Task {
  id            String       @id @default(uuid())
  userId        String
  noticeId      String?
  title         String
  description   String?
  deadline      DateTime?
  priority      String       @default("MEDIUM") // 'LOW', 'MEDIUM', 'HIGH'
  status        String       @default("PENDING") // 'PENDING', 'IN_PROGRESS', 'COMPLETED'
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice        Notice?      @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  notifications Notification[]
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  taskId      String?
  message     String
  type        String
  read        Boolean          @default(false)
  scheduledAt DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
}
